LLM_PROVIDER=openai

OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key

API_BASE_URL=http://localhost:8000

# --- Gmail: OAuth 2.0 (Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID) ---
# Enable "Gmail API" for the project. Create an OAuth client (Desktop or Web app).
# Add http://localhost:8000/auth/callback as an Authorized Redirect URI.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Optional: set this to skip the browser login flow (e.g. for headless/server use).
# Leave empty to use the Connect Gmail button in the UI instead.
GMAIL_OAUTH_REFRESH_TOKEN=

GMAIL_MAX_RESULTS=10
GMAIL_QUERY=in:inbox
GMAIL_LABEL_IDS=INBOX

# --- Polling interval (seconds) ---
GMAIL_POLL_INTERVAL_SECONDS=300

# --- Calendar: how many days ahead to fetch events ---
CALENDAR_LOOKAHEAD_DAYS=14

# --- Token encryption (optional) ---
# If set, Butlr uses this Fernet key to encrypt the stored OAuth token instead
# of auto-generating a key file.  Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BUTLR_TOKEN_KEY=
